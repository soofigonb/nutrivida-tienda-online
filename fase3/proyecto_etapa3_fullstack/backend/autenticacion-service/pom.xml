<?xml version="1.0" encoding="UTF-8"?>
<!-- Define este proyecto Maven. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Indica la versión 4.0.0 del formato POM de Maven. -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Selecciona la versión 4.0.9. -->
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>cl.nutrivida</groupId>
    <artifactId>autenticacion-service</artifactId>
    <!-- Selecciona la versión 0.0.1-SNAPSHOT. -->
    <version>0.0.1-SNAPSHOT</version>
    <name>autenticacion-service</name>
    <!-- Descripción del propósito del componente. -->
    <description>Servicio de autenticación y autorización de NutriVida</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>3.0.3</springdoc.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- Dependencias del proyecto. -->
    <dependencies>

        <!-- API REST -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Persistencia -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- Esta dependencia se necesita al ejecutar la aplicación. -->
            <scope>runtime</scope>
        </dependency>

        <!-- Migraciones de la base de datos -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <!-- Añade a Flyway el soporte específico de PostgreSQL. -->
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Validaciones -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Seguridad y soporte para JWT -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Documentación OpenAPI y Swagger UI -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- Selecciona la versión ${springdoc.version}. -->
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Generación de código repetitivo -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Herramientas de desarrollo -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <!-- Esta dependencia se necesita al ejecutar la aplicación. -->
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas generales: JUnit, Mockito y utilidades -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de controladores -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de persistencia -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de seguridad -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Agrupa las herramientas que construyen el componente. -->
    <build>
        <plugins>

            <!-- Procesamiento de anotaciones Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- Agrupa opciones específicas del plugin que la contiene. -->
                <configuration>
                    <annotationProcessorPaths>
                        <!-- Declara el artefacto de un procesador de anotaciones. -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Empaquetado ejecutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Agrupa opciones específicas del plugin que la contiene. -->
                <configuration>
                    <excludes>
                        <!-- Describe una dependencia que se excluye del JAR. -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Reporte de cobertura -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- Selecciona la versión ${jacoco.version}. -->
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Exige al menos 81 % de líneas. -->
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.81</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
