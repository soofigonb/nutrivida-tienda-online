<?xml version="1.0" encoding="UTF-8"?>
<!-- Define este proyecto Maven. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Indica la versión 4.0.0 del formato POM de Maven. -->
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Selecciona la versión 4.0.9. -->
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>cl.nutrivida</groupId>
    <artifactId>api-gateway</artifactId>
    <!-- Selecciona la versión 0.0.1-SNAPSHOT. -->
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <!-- Descripción del propósito del componente. -->
    <description>API Gateway de NutriVida</description>

    <properties>
        <java.version>17</java.version>
        <!-- Versión de Spring Cloud. -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <!-- Dependencias del proyecto. -->
    <dependencies>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- Herramientas para pruebas -->
        <!-- Declara una dependencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Administra las versiones compatibles de Spring Cloud -->
    <!-- Administra versiones compartidas. -->
    <dependencyManagement>
        <!-- Dependencias del proyecto. -->
        <dependencies>
            <!-- Declara una dependencia. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <!-- Selecciona la versión ${spring-cloud.version}. -->
                <version>${spring-cloud.version}</version>
                <!-- Importa las versiones del BOM. -->
                <type>pom</type>
                <!-- Importa las versiones declaradas por el BOM. -->
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Agrupa las herramientas que construyen el componente. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
