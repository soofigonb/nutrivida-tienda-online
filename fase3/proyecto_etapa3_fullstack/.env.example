# Acceso al frontend y origen exacto permitido.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false

# Conserva el mismo emisor en todos los servicios.
JWT_ISSUER=http://localhost:8081
JWT_PRIVATE_KEY_FILE=./secrets/private.pem
JWT_PUBLIC_KEY_FILE=./secrets/public.pem

# Crea un administrador inicial si la base aún no tiene uno.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Para cada servicio, usa la URL JDBC, el usuario y la contraseña de su base.
# Ejemplo de formato: jdbc:postgresql://<host>:5432/postgres?sslmode=require
AUTENTICACION_DB_URL=
AUTENTICACION_DB_USERNAME=
AUTENTICACION_DB_PASSWORD=

PACIENTES_DB_URL=
PACIENTES_DB_USERNAME=
PACIENTES_DB_PASSWORD=

CATALOGO_DB_URL=
CATALOGO_DB_USERNAME=
CATALOGO_DB_PASSWORD=

PROFESIONALES_DB_URL=
PROFESIONALES_DB_USERNAME=
PROFESIONALES_DB_PASSWORD=

AGENDAMIENTO_DB_URL=
AGENDAMIENTO_DB_USERNAME=
AGENDAMIENTO_DB_PASSWORD=

ORDENES_DB_URL=
ORDENES_DB_USERNAME=
ORDENES_DB_PASSWORD=
